PAYPAL_CLIENT_SECRET=payment-paypal-client-secret-dev:latest

# 事件推送。**缺席時服務照常啟動，只是推送關閉**（/health 的 push 會說）——
# 第一次部署時 secret 還沒建，硬性必填會讓服務起不來，
# 而沒有推送的服務仍然是完全可用的服務（GET /v1/events 還在）。
#
# ⚠️ 但反過來說：這裡一旦寫上名字，**secret 就必須先存在**，
# 否則新 revision 起不來（Cloud Run 掛載不到就直接失敗）。先建 secret 再 push。
WEBHOOK_SIGNING_KEY=payment-paypal-webhook-signing-key-dev:latest
INTERNAL_KEY=payment-paypal-internal-key-dev:latest
