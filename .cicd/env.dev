LOG_LEVEL=debug
PAYPAL_ENV=sandbox

# 專屬的 sandbox app「adamsourceinfo-payments」。
# （PayPal 不允許 app 名稱含 "paypal"，所以不叫 payment-paypal。）
# client id 是半公開的 —— 前端 SDK 本來就看得到，放環境變數即可。
PAYPAL_CLIENT_ID=BAA7xYxCZSCAQsaCEopsQijndEomIqAvu-5GRXZd_pxVnskrYyookei28XL9eJErZpjSSbgrrrN3ep0aqI

# 不是機密，只是識別碼 —— 沒有 client secret 它什麼也做不到。
# dev/prod 是兩個獨立的 webhook 註冊，各自不同 id，所以不能放 env.common。
PAYPAL_WEBHOOK_ID=63S68208MU508283M
